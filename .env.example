# Copy to .env and fill in. Every value below is a placeholder.

# PostgreSQL connection string (matches the `db` service in docker-compose.yml).
DATABASE_URL=postgres://fewchat:fewchat@localhost:5432/fewchat
# Public base URL of this app; Meta webhooks and OAuth redirects point here (HTTPS in production).
APP_URL=http://localhost:3000
# Meta app ID from the Meta developer dashboard.
META_APP_ID=your-meta-app-id
# Meta app secret; also used to verify webhook signatures. Never commit the real one.
META_APP_SECRET=your-meta-app-secret
# Any random string; enter the same value when subscribing the webhook in the Meta dashboard.
META_WEBHOOK_VERIFY_TOKEN=change-me-random-string
# Graph API version to call, e.g. v24.0.
META_GRAPH_API_VERSION=v24.0
# Key for encrypting stored Instagram tokens, at least 32 chars (e.g. `openssl rand -base64 32`).
TOKEN_ENCRYPTION_KEY=change-me-at-least-32-characters-long
# Hash of the single admin's password (the hashing command is documented with the auth phase).
ADMIN_PASSWORD_HASH=change-me-password-hash
# Secret for signing admin session cookies, at least 32 chars (e.g. `openssl rand -base64 32`).
SESSION_SECRET=change-me-at-least-32-characters-long
